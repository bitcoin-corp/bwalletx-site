{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/person/:handle",
      "destination": "https://www.bit-sign.online/api/public/profile/:handle"
    },
    {
      "source": "/u/:handle",
      "destination": "/person"
    },
    {
      "source": "/:handle(\\$[A-Za-z0-9_-]{3,30}|%24[A-Za-z0-9_-]{3,30})",
      "destination": "/person"
    },
    {
      "source": "/lock/verify",
      "destination": "/lock/verify.html"
    },
    {
      "source": "/push",
      "destination": "/push-notifications"
    },
    {
      "source": "/.well-known/bsvalias",
      "destination": "https://pay.bwallet.space/.well-known/bsvalias"
    },
    {
      "source": "/api/waitlist",
      "destination": "https://www.bwallet.space/api/waitlist"
    },
    {
      "source": "/api/apps-submit",
      "destination": "https://www.bwallet.space/api/apps-submit"
    },
    {
      "source": "/api/strategies",
      "destination": "https://www.bwallet.space/api/strategies"
    }
  ],
  "redirects": [
    {
      "source": "/u/bchat/:handle",
      "destination": "https://www.bchatx.com/u/:handle",
      "permanent": false
    },
    {
      "source": "/bMail",
      "destination": "/bmail",
      "statusCode": 301
    },
    {
      "source": "/BMAIL",
      "destination": "/bmail",
      "statusCode": 301
    },
    {
      "source": "/BMail",
      "destination": "/bmail",
      "statusCode": 301
    },
    {
      "source": "/Bmail",
      "destination": "/bmail",
      "statusCode": 301
    },
    {
      "source": "/bPhone",
      "destination": "/bphone",
      "statusCode": 301
    },
    {
      "source": "/download/:file(bwalletx-android(?!-5.1.89\\.apk$)[^/]*\\.apk)",
      "destination": "/download/bwalletx-android-5.1.89.apk",
      "statusCode": 302
    },
    {
      "source": "/download/:file(bwalletx-extension(?!-5.1.89\\.zip$)[^/]*\\.zip)",
      "destination": "/download/bwalletx-extension-5.1.89.zip",
      "statusCode": 302
    },
    {
      "source": "/PNEE",
      "destination": "/pnees",
      "permanent": true
    },
    {
      "source": "/penny-notes",
      "destination": "/pnees",
      "permanent": true
    },
    {
      "source": "/PNEES",
      "destination": "/pnees",
      "permanent": true
    },
    {
      "source": "/watch",
      "destination": "/video",
      "statusCode": 301
    },
    {
      "source": "/twitter",
      "destination": "/x",
      "permanent": true
    },
    {
      "source": "/kyc",
      "destination": "/identity#verify",
      "permanent": true
    },
    {
      "source": "/bmovies",
      "destination": "/bapps/bmovies",
      "statusCode": 308
    }
  ],
  "headers": [
    {
      "source": "/download/(.*)\\.(apk|zip)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
