{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/themes/custom",
      "destination": "/themes-custom"
    },
    {
      "source": "/themes/:colour(white|pink|blue|yellow|vexvoid|gold|dark|npg|npgx)",
      "destination": "/themes"
    },
    {
      "source": "/api/person/:handle",
      "destination": "https://www.bit-sign.online/api/public/profile/:handle"
    },
    {
      "source": "/u/:handle",
      "destination": "/person"
    },
    {
      "source": "/:handle(\\$[A-Za-z0-9_-]{3,30}|%24[A-Za-z0-9_-]{3,30})",
      "destination": "/person"
    },
    {
      "source": "/lock/verify",
      "destination": "/lock/verify.html"
    },
    {
      "source": "/push",
      "destination": "/push-notifications"
    },
    {
      "source": "/.well-known/bsvalias",
      "destination": "https://pay.bwallet.space/.well-known/bsvalias"
    },
    {
      "source": "/api/waitlist",
      "destination": "https://www.bwallet.space/api/waitlist"
    },
    {
      "source": "/api/apps-submit",
      "destination": "https://www.bwallet.space/api/apps-submit"
    },
    {
      "source": "/api/strategies",
      "destination": "https://www.bwallet.space/api/strategies"
    },
    {
      "source": "/api/shops/:op",
      "destination": "https://www.bwallet.space/api/shops/:op"
    }
  ],
  "redirects": [
    { "source": "/recover-relayX", "destination": "/recover-relayx", "permanent": true },
    { "source": "/relayx-nfts", "destination": "/recover-relayx", "permanent": true },
    {
      "source": "/theme/:colour(white|pink|blue|yellow|vexvoid|gold|dark|npg|npgx)",
      "destination": "/themes/:colour",
      "permanent": false
    },
    {
      "source": "/theme",
      "destination": "/themes",
      "permanent": false
    },
    {
      "source": "/:i(invites|Invites|INVITES|Invite|INVITE)",
      "destination": "/invite",
      "permanent": false
    },
    {
      "source": "/:g(bgigs|bGigs|BGigs)",
      "destination": "/gigs",
      "permanent": false
    },
    {
      "source": "/:v(bvault|bVault|BVault)",
      "destination": "/btrust",
      "permanent": false
    },
    {
      "source": "/BTrust",
      "destination": "/btrust",
      "permanent": true
    },
    {
      "source": "/bTrust",
      "destination": "/btrust",
      "permanent": true
    },
    {
      "source": "/twetch",
      "destination": "https://twetch.com/u/220501",
      "permanent": false
    },
    {
      "source": "/restore-simplycash",
      "destination": "/sweep-simplycash",
      "permanent": true
    },
    {
      "source": "/room/:path*",
      "destination": "https://www.bchatx.com/room/:path*",
      "permanent": false
    },
    {
      "source": "/u/bchat/:handle",
      "destination": "https://www.bchatx.com/u/:handle",
      "permanent": false
    },
    {
      "source": "/bMail",
      "destination": "/bmail",
      "statusCode": 301
    },
    {
      "source": "/BMAIL",
      "destination": "/bmail",
      "statusCode": 301
    },
    {
      "source": "/BMail",
      "destination": "/bmail",
      "statusCode": 301
    },
    {
      "source": "/Bmail",
      "destination": "/bmail",
      "statusCode": 301
    },
    {
      "source": "/bPhone",
      "destination": "/bphone",
      "statusCode": 301
    },
    {
      "source": "/download/:file(bwalletx-android(?!-5.2.36\\.apk$)[^/]*\\.apk)",
      "destination": "/download/bwalletx-android-5.2.36.apk",
      "statusCode": 302
    },
    {
      "source": "/download/:file(bwalletx-extension(?!-5.2.36\\.zip$)[^/]*\\.zip)",
      "destination": "/download/bwalletx-extension-5.2.36.zip",
      "statusCode": 302
    },
    {
      "source": "/download/:file(bwalletx-desktop(?!-5\\.2\\.33-mac\\.dmg$)[^/]*\\.dmg)",
      "destination": "/download/bwalletx-desktop-5.2.32-mac.dmg",
      "statusCode": 302
    },
    {
      "source": "/PNEE",
      "destination": "/pnees",
      "permanent": true
    },
    {
      "source": "/penny-notes",
      "destination": "/pnees",
      "permanent": true
    },
    {
      "source": "/PNEES",
      "destination": "/pnees",
      "permanent": true
    },
    {
      "source": "/watch",
      "destination": "/video",
      "statusCode": 301
    },
    {
      "source": "/twitter",
      "destination": "/x",
      "permanent": true
    },
    {
      "source": "/kyc",
      "destination": "/identity#verify",
      "permanent": true
    },
    {
      "source": "/bmovies",
      "destination": "/bapps/bmovies",
      "statusCode": 308
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/download/(.*)\\.dmg",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/x-apple-diskimage"
        }
      ]
    },
    {
      "source": "/download/(.*)\\.(apk|zip|dmg)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/download/latest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ]
}
