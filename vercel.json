{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/push",
      "destination": "/push-notifications"
    },
    {
      "source": "/.well-known/bsvalias",
      "destination": "https://pay.bwallet.space/.well-known/bsvalias"
    },
    {
      "source": "/api/waitlist",
      "destination": "https://www.bwallet.space/api/waitlist"
    },
    {
      "source": "/api/apps-submit",
      "destination": "https://www.bwallet.space/api/apps-submit"
    },
    {
      "source": "/api/strategies",
      "destination": "https://www.bwallet.space/api/strategies"
    }
  ],
  "redirects": [
    {
      "source": "/download/:file(bwalletx-android(?!-5.1.81\\.apk$)[^/]*\\.apk)",
      "destination": "/download/bwalletx-android-5.1.81.apk",
      "statusCode": 302
    },
    {
      "source": "/download/:file(bwalletx-extension(?!-5.1.81\\.zip$)[^/]*\\.zip)",
      "destination": "/download/bwalletx-extension-5.1.81.zip",
      "statusCode": 302
    },
    {
      "source": "/PNEE",
      "destination": "/pnees",
      "permanent": true
    },
    {
      "source": "/penny-notes",
      "destination": "/pnees",
      "permanent": true
    },
    {
      "source": "/PNEES",
      "destination": "/pnees",
      "permanent": true
    },
    {
      "source": "/watch",
      "destination": "/video",
      "statusCode": 301
    },
    {
      "source": "/twitter",
      "destination": "/x",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/download/(.*)\\.(apk|zip)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
